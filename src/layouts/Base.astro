---
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "@fontsource-variable/dm-sans/wght.css";
import "@fontsource/bagel-fat-one/latin-400.css";
import "../styles/site.css";
import "../styles/pages.css";
import "../styles/kit.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import KitModal from "../components/KitModal.astro";
import { site, book, cover, editions } from "../data/book.js";
import displayFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import bodyFont from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import { organization, website, bookNode, coverImage, contributors } from "../data/schema.js";

const {
  title,
  description,
  path = Astro.url.pathname,
  schema = [],
  ogType = "website",
  noindex = false,
  footerKit = true,
} = Astro.props;
// The approval preview under /v2 is never indexable.
const preview = import.meta.env.BASE_URL !== "/";
const canonical = `${site.origin}${path === "/" ? "/" : path}`;
// Every page carries the full book entity (book, cover, people, publisher) so each one names the same official work.
const nodes = [website, organization, bookNode, coverImage, ...contributors, ...schema];
const graph = {
  "@context": "https://schema.org",
  "@graph": nodes.filter((node, index) => !node["@id"] || nodes.findIndex((other) => other["@id"] === node["@id"]) === index),
};
const coverUrl = `${site.origin}${cover.path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ gtm: site.gtm }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", gtm);
    </script>
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <meta name="theme-color" content="#fff8ee" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex || preview ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="The Hanukkah Fairy" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={coverUrl} />
    <meta property="og:image:secure_url" content={coverUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(cover.width)} />
    <meta property="og:image:height" content={String(cover.height)} />
    <meta property="og:image:alt" content={cover.alt} />
    {ogType === "book" && (
      <>
        {book.authors.map((name) => <meta property="book:author" content={name} />)}
        <meta property="book:isbn" content={editions[0].isbn} />
        <meta property="book:release_date" content={book.published} />
        <meta property="book:tag" content="Hanukkah" />
        <meta property="book:tag" content="Picture book" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={coverUrl} />
    <meta name="twitter:image:alt" content={cover.alt} />
    <meta name="author" content={book.authors.join(" and ")} />
    <link rel="image_src" href={coverUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body id="top">
    <noscript
      ><iframe
        src={`https://www.googletagmanager.com/ns.html?id=${site.gtm}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe></noscript
    >
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer showKit={footerKit} />
    <KitModal />
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
