---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
---

<Base title="Page not found | The Hanukkah Fairy" description="This page is hiding." path="/404" noindex>
  <PageHero tone="sky" crumb="Not found">
    <Fragment slot="title">Clever<br />hiding spot.</Fragment>
    <p>This page is hiding better than the Fairy does. Try one of these.</p>
    <p class="page-hero-actions">
      <a class="button" href="/">Home</a>
      <a class="text-link" href="/book">The book</a>
      <a class="text-link" href="/eight-nights">Eight nights</a>
    </p>
  </PageHero>
</Base>
