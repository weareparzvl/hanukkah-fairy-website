---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { faq } from "../data/faq.js";
import { breadcrumbs, page } from "../data/schema.js";

const title = "Questions About The Hanukkah Fairy Book and Tradition";
const description =
  "Answers for grown-ups: what ages The Hanukkah Fairy is for, where to buy it, how the eight-night tradition works and what is in the free kit.";
const schema = [
  page("/faq", title, description),
  breadcrumbs([["Questions", "/faq"]]),
  {
    "@type": "FAQPage",
    mainEntity: faq.flatMap((group) =>
      group.items.map(([name, text]) => ({
        "@type": "Question",
        name,
        acceptedAnswer: { "@type": "Answer", text },
      })),
    ),
  },
];
---

<Base title={title} description={description} path="/faq" schema={schema}>
  <PageHero tone="lilac" crumb="Questions">
    <Fragment slot="title">For the<br />grown-ups.</Fragment>
    <p>The short answers, all on one page.</p>
  </PageHero>
  {faq.map((group, index) => (
    <section class:list={["page-section", { "tone-paper-deep": index % 2 === 1 }]}>
      <div class="wrap split">
        <h2>{group.group}</h2>
        <div class="prose qa">
          {group.items.map(([question, answer]) => (
            <>
              <h3>{question}</h3>
              <p>{answer}</p>
            </>
          ))}
          {index === 0 && <p class="prose-actions"><a class="text-link" href="/book">Every edition of the book</a></p>}
          {index === 1 && <p class="prose-actions"><a class="text-link" href="/tradition">The tradition, step by step</a></p>}
          {index === 2 && <p class="prose-actions"><a class="button" href="/kit" data-kit-open data-entry="faq">Get the free 8-Night Kit</a><a class="text-link" href="/privacy">Privacy details</a></p>}
        </div>
      </div>
    </section>
  ))}
</Base>
