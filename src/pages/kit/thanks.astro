---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import KitStack from "../../components/KitStack.astro";
import { kit, hanukkah } from "../../data/book.js";
const title = "Your 8-Night Kit | The Hanukkah Fairy";
---

<Base title={title} description="Download The Fairy’s 8-Night Kit." path="/kit/thanks" noindex footerKit={false}>
  <PageHero tone="yellow" crumb="Your kit">
    <Fragment slot="title">It’s yours.</Fragment>
    <p>Print it tonight. The first candle is {hanukkah.first}.</p>
    <p class="page-hero-actions">
      <a class="button" href={kit.file} download data-kit-download>Download the kit (PDF)</a>
      <a class="text-link" href="/tradition">How the tradition works</a>
    </p>
    <KitStack slot="art" sizes="(max-width: 760px) 62vw, 32vw" loading="eager" />
  </PageHero>
</Base>
