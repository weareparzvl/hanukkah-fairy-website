  "narrative": {
    "overview": "The approved book artwork anchors an exuberant illustrated world: an electric-blue nightscape, coral/pink wordmark, turquoise Fairy, acid-yellow announcements and distinct full-width character colors. Oversized campaign type gives the art room to lead; readable body copy explains the book and family ritual.\n\nThe implemented direction is recorded from css/site.css, css/reader.css and js/reader.js, with approved context in reviews/elise-feedback-2026-09-28.md. No additional creative metaphor has been approved. Tokens above describe source values; component-specific and responsive overrides remain authoritative in the CSS.",
    "keyCharacteristics": [
      "Supplied book art at generous scale.",
      "Full-width color sections and oversized headings.",
      "Warm paper reading surfaces with a physical book seam.",
      "Restrained scroll motion and a legible static fallback."
    ],
    "rules": [
      {
        "name": "The Artwork Authority Rule",
        "body": "Preserve the supplied cover, logo, liner and character colors; use section fills to support those assets.",
        "section": "colors"
      },
      {
        "name": "The Reading Rhythm Rule",
        "body": "Tight display leading belongs to headlines. Keep explanatory text at the observed 1.5\u20131.7 leading; reader text and artwork must remain complete.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the supplied artwork and original product mockups.",
      "Do preserve readable text, complete book pages and visible keyboard focus.",
      "Do adapt large compositions into the implemented mobile reading order.",
      "Do keep motion tied to scrolling and honor reduced motion."
    ],
    "donts": [
      "Don't invent replacement character designs or product imagery.",
      "Don't crop book text or rotate the cover away from its fixed seam.",
      "Don't add Back/Next or dot controls to the reader.",
      "Don't use the tight campaign-heading leading for body copy."
    ]
  }
