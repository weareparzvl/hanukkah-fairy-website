{
  "name": "hanukkah-fairy-website",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 8761",
    "build": "astro build",
    "preview": "astro build && node --env-file-if-exists=.env.local server.mjs",
    "kit": "node scripts/build-kit.mjs",
    "icons": "node scripts/build-icons.mjs",
    "test": "node --test tests/*.test.mjs",
