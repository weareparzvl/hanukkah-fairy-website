    "build:v2": "node scripts/build-v2-preview.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/bagel-fat-one": "^5.3.0",
    "@vercel/blob": "^2.8.0",
    "astro": "^7.4.10"
  }
}
